# Environment variables. The glob matters: a .env.bak left by an edit holds the
# same secrets as .env and would otherwise be untracked, not ignored.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Bot data (warnings, runtime state)
data/
*.json.tmp

# AI assistant tooling: local config, instruction files and scratch output.
# None of it belongs in the repo.
.claude/
.cursor/
.cursorrules
.windsurf/
.codeium/
.continue/
.aider*
.plandex/
.specstory/
.roo/
.cline/
.gemini/
.opencode/
.mcp.json
.agent/
.agents/
CLAUDE.md
AGENTS.md
GEMINI.md
CONVENTIONS.md
.github/copilot-instructions.md
ai-docs/
*.ai.md
*.plan.md
