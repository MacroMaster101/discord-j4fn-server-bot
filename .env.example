# Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# Admin Dashboard Password (Optional - leave blank to auto-generate a secure password on boot)
ADMIN_PASSWORD=

# Web Panel Port (Default 8080)
PORT=8080

# Cloudflare Tunnel Token (Required for Cloudflare Zero Trust tunnel)
TUNNEL_TOKEN=eyJh...your_cloudflare_tunnel_token...
