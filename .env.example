# Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# Admin Dashboard Password (Optional - leave blank to auto-generate a secure password on boot)
ADMIN_PASSWORD=

# Web Panel Port (Default 8080)
PORT=8080

# Address the web panel listens on. Use 127.0.0.1 when running locally; leave unset in
# Docker (it must be 0.0.0.0 there for the tunnel to reach it).
# WEB_HOST=127.0.0.1

# Cloudflare Access sign-in for /admin (both required to enable it; without them only the
# admin token works). The AUD tag is on the Access application's Overview page.
CF_ACCESS_TEAM_DOMAIN=damp-leaf-bc5b.cloudflareaccess.com
CF_ACCESS_AUD=

# Host address the dashboard port is published on. 127.0.0.1 keeps the origin reachable
# only through the Cloudflare tunnel.
DASHBOARD_BIND_ADDRESS=127.0.0.1

# Cloudflare Tunnel Token (Required for Cloudflare Zero Trust tunnel)
TUNNEL_TOKEN=eyJh...your_cloudflare_tunnel_token...

# ---------------------------------------------------------------------------
# Cloud OCR for the anti-spam filter (OPTIONAL, OFF by default)
#
# Lets the filter read the words inside a posted image, which catches a scam
# screenshot that carries no caption. It UPLOADS MEMBER-POSTED IMAGES to the
# provider below, so enable it only if that is acceptable for your server, and
# say so in your rules.
#
# Supported: ocrspace (free tier, https://ocr.space/ocrapi)
#            google   (Cloud Vision, API-key auth)
# Leave OCR_PROVIDER blank to keep it disabled.
#
# Both of these must be set, AND `$automod set ocr_enabled on` must be run,
# before a single call is made. Calls are gated hard: only images from
# untrusted members whose caption is not already damning, capped per hour, and
# cached per image so a reposted screenshot is never paid for twice.
OCR_PROVIDER=
OCR_API_KEY=

# ---------------------------------------------------------------------------
# Discord sign-in, so the admins of servers that add this bot can configure it
# themselves at /dashboard. They only ever see servers they already run AND
# that the bot is in; the Cloudflare Access console stays owner-only.
#
# From https://discord.com/developers/applications -> your app -> OAuth2.
# Add the exact redirect URI below to that page's Redirects list.
# Leave blank to keep Discord sign-in switched off.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://your-domain.example/auth/discord/callback

# Signs the session cookie. Generated automatically on first boot if unset;
# keep it stable or every deploy signs people out.
FLASK_SECRET_KEY=

# Set to 0 only for plain-http local development.
COOKIE_SECURE=1
