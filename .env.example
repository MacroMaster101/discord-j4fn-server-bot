# Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# Admin Dashboard Password (Optional - leave blank to auto-generate a secure password on boot)
ADMIN_PASSWORD=

# Web Panel Port (Default 8080)
PORT=8080

# Address the web panel listens on. Use 127.0.0.1 when running locally; leave unset in
# Docker (it must be 0.0.0.0 there for the tunnel to reach it).
# WEB_HOST=127.0.0.1

# Cloudflare Access sign-in for /admin (both required to enable it; without them only the
# admin token works). The AUD tag is on the Access application's Overview page.
CF_ACCESS_TEAM_DOMAIN=damp-leaf-bc5b.cloudflareaccess.com
CF_ACCESS_AUD=

# Host address the dashboard port is published on. 127.0.0.1 keeps the origin reachable
# only through the Cloudflare tunnel.
DASHBOARD_BIND_ADDRESS=127.0.0.1

# Cloudflare Tunnel Token (Required for Cloudflare Zero Trust tunnel)
TUNNEL_TOKEN=eyJh...your_cloudflare_tunnel_token...
